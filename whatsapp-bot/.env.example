# Copiá este archivo como variables de entorno en tu hosting (Render, etc.),
# NO subas un archivo .env con valores reales a GitHub.

# Token de acceso de WhatsApp Cloud API (temporal o permanente, de Meta for Developers)
WHATSAPP_TOKEN=

# Phone Number ID que te da Meta al configurar el número de WhatsApp
WHATSAPP_PHONE_NUMBER_ID=

# Cualquier palabra secreta que vos elijas; se usa para verificar el webhook con Meta
VERIFY_TOKEN=

# Tu clave de Gemini (la misma que usás en la app, de Google AI Studio)
GEMINI_API_KEY=

# Opcional: no hace falta tocarlos, ya apuntan a la base de datos de la app
# FIRESTORE_PROJECT_ID=morlinavivero-90956
# FIRESTORE_API_KEY=AIzaSyAVjMnA_eStmyurFJOoG2TbCCChfhKUdyA
# WHATSAPP_API_VERSION=v21.0
