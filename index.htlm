&#x20;   **<!-- CUSTOM TIMED DELETE CONFIRMATION MODAL -->**

&#x20;   **<div id="deleteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">**

&#x20;       **<div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl space-y-4 text-center">**

&#x20;           **<div class="w-14 h-14 bg-rose-50 text-rose-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-inner">**

&#x20;               **<i class="fa-solid fa-triangle-exclamation"></i>**

&#x20;           **</div>**

&#x20;           **<div>**

&#x20;               **<h3 class="font-bold text-slate-900 text-lg">¿Confirmar Eliminación?</h3>**

&#x20;               **<p id="deleteModalText" class="text-xs text-slate-500 mt-1">Esta acción no se puede deshacer.</p>**

&#x20;           **</div>**

&#x20;           **<div class="bg-slate-50 py-3 px-4 rounded-2xl border border-slate-100 flex items-center justify-center gap-2">**

&#x20;               **<i class="fa-solid fa-clock text-rose-500 animate-pulse"></i>**

&#x20;               **<span class="text-xs font-semibold text-slate-600">Espera <span id="deleteTimerCount" class="text-rose-600 font-bold text-sm">3</span>s para confirmar</span>**

&#x20;           **</div>**

&#x20;           **<div class="grid grid-cols-2 gap-2 pt-2">**

&#x20;               **<button type="button" onclick="closeDeleteModal()" class="py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">Cancelar</button>**

&#x20;               **<button type="button" id="confirmDeleteBtn" disabled class="py-2.5 bg-slate-200 text-slate-400 text-xs font-semibold rounded-xl transition cursor-not-allowed">Eliminar</button>**

&#x20;           **</div>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<script>**

&#x20;       **let db = null;**

&#x20;       **let useFirebase = false;**

&#x20;       **let lastSyncTime = 'Nunca';**

&#x20;       **let deleteTimerInterval = null;**

&#x20;       **let unsubscribeSnapshot = null;**

&#x20;       **let hideBuyPrice = false;**

&#x20;       **let currentExcelCategory = 'plants';**



&#x20;       **const FIXED\_FIREBASE\_CONFIG = {**

&#x20;           **apiKey: "AIzaSyBn86ARo8leHh73bHJOLCmeGAmvsDp764Q",**

&#x20;           **authDomain: "viveromorlina.firebaseapp.com",**

&#x20;           **databaseURL: "https://viveromorlina-default-rtdb.firebaseio.com",**

&#x20;           **projectId: "viveromorlina",**

&#x20;           **storageBucket: "viveromorlina.firebasestorage.app",**

&#x20;           **messagingSenderId: "901168564249",**

&#x20;           **appId: "1:901168564249:web:7fb9be4a65190de3df8288",**

&#x20;           **measurementId: "G-NG3B3Q9T1L"**

&#x20;       **};**



&#x20;       **function formatMoney(val) {**

&#x20;           **const num = Number(val) || 0;**

&#x20;           **return '$ ' + num.toLocaleString('es-AR');**

&#x20;       **}**



&#x20;       **let dbData = {**

&#x20;           **plants: \[**

&#x20;               **{ id: 'p1', name: 'Monstera Deliciosa', family: 'Araceae', location: 'Interior', pot: 'Maceta N° 16', buyPrice: 8000, sellPrice: 16000, updateDate: '2026-03-01', image: 'https://images.unsplash.com/photo-1614594975525-e45190c55d0b?w=400' },**

&#x20;               **{ id: 'p2', name: 'Ficus Lyrata', family: 'Moraceae', location: 'Interior / Exterior', pot: 'Maceta N° 18', buyPrice: 15000, sellPrice: 30000, updateDate: '2026-03-02', image: 'https://images.unsplash.com/photo-1545241047-6083a3684587?w=400' },**

&#x20;               **{ id: 'p3', name: 'Sansevieria', family: 'Asparagaceae', location: 'Interior', pot: 'Maceta N° 12', buyPrice: 4000, sellPrice: 8000, updateDate: '2026-03-03', image: 'https://images.unsplash.com/photo-1509423350716-97f9360b4e09?w=400' }**

&#x20;           **],**

&#x20;           **pots: \[**

&#x20;               **{ id: 'pt1', name: 'Maceta Plástica N° 14', measure: 'N° 14 (14cm)', material: 'Plástico reforzado', buyPrice: 1500, sellPrice: 3000, image: 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=400' },**

&#x20;               **{ id: 'pt2', name: 'Maceta Barro N° 18', measure: 'N° 18 (18cm)', material: 'Barro / Terracota', buyPrice: 3000, sellPrice: 6000, image: 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=400' }**

&#x20;           **],**

&#x20;           **accessories: \[**

&#x20;               **{ id: 'ac1', name: 'Tutor de Madera 1m', measure: '1 Metro', material: 'Madera tratada', buyPrice: 1000, sellPrice: 2000, image: 'https://images.unsplash.com/photo-1592417817098-8f3d69204b56?w=400' }**

&#x20;           **],**

&#x20;           **chemicals: \[**

&#x20;               **{ id: 'ch1', name: 'Fertilizante Líquido 250cc', type: 'Fertilizante', application: 'Riego', dilution: '5ml / Litro agua', measure: '250 cc', buyPrice: 4000, sellPrice: 8000, image: 'https://images.unsplash.com/photo-1585336261022-6fc0e69de2a3?w=400' }**

&#x20;           **],**

&#x20;           **soils: \[**

&#x20;               **{ id: 'sl1', name: 'Tierra Preparada Premium', brand: 'TerraFertil', type: 'Tierra Preparada', measure: '10 Litros', buyPrice: 3000, sellPrice: 6000, image: 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400' }**

&#x20;           **],**

&#x20;           **sales: \[**

&#x20;               **{ id: 's1', date: '2026-03-03 10:30', itemName: 'Monstera Deliciosa', qty: 2, total: 32000 }**

&#x20;           **]**

&#x20;       **};**



&#x20;       **window.addEventListener('DOMContentLoaded', () => {**

&#x20;           **localStorage.setItem('vivero\_fb\_config', JSON.stringify(FIXED\_FIREBASE\_CONFIG));**

&#x20;           **initFirebase(FIXED\_FIREBASE\_CONFIG, false);**

&#x20;           **renderPlants();**

&#x20;       **});**



&#x20;       **function requestToggleBuyPrice() {**

&#x20;           **const password = prompt("Ingresa la contraseña para cambiar la visibilidad de costos:");**

&#x20;           **if (password === "7714") {**

&#x20;               **hideBuyPrice = !hideBuyPrice;**

&#x20;               **const btn = document.getElementById('toggleBuyPriceBtn');**

&#x20;               **const circle = document.getElementById('toggleBuyPriceCircle');**

&#x20;               **if (hideBuyPrice) {**

&#x20;                   **btn.classList.remove('bg-slate-300');**

&#x20;                   **btn.classList.add('bg-emerald-600');**

&#x20;                   **circle.classList.remove('translate-x-0');**

&#x20;                   **circle.classList.add('translate-x-5');**

&#x20;               **} else {**

&#x20;                   **btn.classList.remove('bg-emerald-600');**

&#x20;                   **btn.classList.add('bg-slate-300');**

&#x20;                   **circle.classList.remove('translate-x-5');**

&#x20;                   **circle.classList.add('translate-x-0');**

&#x20;               **}**

&#x20;               **renderCurrentTab();**

&#x20;           **} else if (password !== null) {**

&#x20;               **alert("Contraseña incorrecta.");**

&#x20;           **}**

&#x20;       **}**



&#x20;       **function initFirebase(config, showAlert = true) {**

&#x20;           **try {**

&#x20;               **if (!firebase.apps.length) firebase.initializeApp(config);**

&#x20;               **db = firebase.firestore();**

&#x20;               **if (typeof unsubscribeSnapshot === 'function') unsubscribeSnapshot();**



&#x20;               **unsubscribeSnapshot = db.collection('vivero').doc('main\_data').onSnapshot((docRef) => {**

&#x20;                   **useFirebase = true;**

&#x20;                   **updateStatusUI(true, config.projectId);**

&#x20;                   **if (docRef.exists) {**

&#x20;                       **const cloudData = docRef.data();**

&#x20;                       **if (cloudData \&\& cloudData.plants) {**

&#x20;                           **dbData = cloudData;**

&#x20;                           **if (!dbData.soils) dbData.soils = \[];**

&#x20;                           **renderCurrentTab();**

&#x20;                           **lastSyncTime = new Date().toLocaleTimeString();**

&#x20;                       **}**

&#x20;                   **} else {**

&#x20;                       **db.collection('vivero').doc('main\_data').set(dbData).catch(() => {});**

&#x20;                   **}**

&#x20;               **}, (err) => {**

&#x20;                   **useFirebase = false;**

&#x20;                   **updateStatusUI(false);**

&#x20;               **});**

&#x20;           **} catch(err) {**

&#x20;               **useFirebase = false;**

&#x20;               **updateStatusUI(false);**

&#x20;           **}**

&#x20;       **}**



&#x20;       **function updateStatusUI(isCloud, name = '') {**

&#x20;           **const dot = document.getElementById('statusDot');**

&#x20;           **const statusText = document.getElementById('connectionStatus');**

&#x20;           **if (isCloud) {**

&#x20;               **if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';**

&#x20;               **if (statusText) statusText.innerHTML = `<i class="fa-solid fa-check text-emerald-600 font-bold mr-1"></i> Conectado a Firebase (${name || 'viveromorlina'})`;**

&#x20;               **lastSyncTime = new Date().toLocaleTimeString();**

&#x20;           **} else {**

&#x20;               **if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';**

&#x20;               **if (statusText) statusText.textContent = 'Modo Local (Navegador)';**

&#x20;           **}**

&#x20;       **}**



&#x20;       **async function saveDb() {**

&#x20;           **if (useFirebase \&\& db) {**

&#x20;               **try {**

&#x20;                   **await db.collection('vivero').doc('main\_data').set(dbData);**

&#x20;                   **lastSyncTime = new Date().toLocaleTimeString();**

&#x20;               **} catch(err) { useFirebase = false; updateStatusUI(false); }**

&#x20;           **}**

&#x20;           **try { localStorage.setItem('viveroApp\_db\_v3', JSON.stringify(dbData)); } catch(e) {}**

&#x20;       **}**



&#x20;       **function renderCurrentTab() {**

&#x20;           **const activeTabBtn = document.querySelector('nav button.bg-emerald-600');**

&#x20;           **if (!activeTabBtn) return;**

&#x20;           **const activeTab = activeTabBtn.id.replace('tab-', '');**

&#x20;           **if (activeTab === 'plants') renderPlants();**

&#x20;           **else if (activeTab === 'pots') renderItems('pots');**

&#x20;           **else if (activeTab === 'accessories') renderItems('accessories');**

&#x20;           **else if (activeTab === 'chemicals') renderChemicals();**

&#x20;           **else if (activeTab === 'soils') renderSoils();**

&#x20;           **else if (activeTab === 'sales') renderSales();**

&#x20;       **}**



&#x20;       **function switchTab(tabId) {**

&#x20;           **document.querySelectorAll('main > section').forEach(el => el.classList.add('hidden'));**

&#x20;           **const sec = document.getElementById('section-' + tabId);**

&#x20;           **if (sec) sec.classList.remove('hidden');**



&#x20;           **document.querySelectorAll('.tab-btn').forEach(btn => {**

&#x20;               **btn.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm', 'shadow-emerald-200');**

&#x20;               **btn.classList.add('text-slate-600', 'hover:bg-slate-100');**

&#x20;           **});**

&#x20;           **const activeBtn = document.getElementById('tab-' + tabId);**

&#x20;           **if (activeBtn) {**

&#x20;               **activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');**

&#x20;               **activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow-sm', 'shadow-emerald-200');**

&#x20;           **}**

&#x20;           **renderCurrentTab();**

&#x20;       **}**



&#x20;       **// --- RENDER PLANTAS ---**

&#x20;       **function renderPlants() {**

&#x20;           **const grid = document.getElementById('plantsGrid');**

&#x20;           **if (!grid) return;**

&#x20;           **const searchInput = document.getElementById('plantSearch');**

&#x20;           **const locFilterInput = document.getElementById('plantFilterLocation');**

&#x20;           **const search = searchInput ? searchInput.value.toLowerCase() : '';**

&#x20;           **const locFilter = locFilterInput ? locFilterInput.value : '';**



&#x20;           **let list = \[...(dbData.plants || \[])];**

&#x20;           **if (search) list = list.filter(p => (p.name \&\& p.name.toLowerCase().includes(search)) || (p.family \&\& p.family.toLowerCase().includes(search)));**

&#x20;           **if (locFilter) list = list.filter(p => p.location === locFilter);**



&#x20;           **if (list.length === 0) {**

&#x20;               **grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">No se encontraron plantas.</div>`;**

&#x20;               **return;**

&#x20;           **}**



&#x20;           **grid.innerHTML = list.map(p => {**

&#x20;               **const safeName = (p.name || '').replace(/'/g, "\\'").replace(/"/g, '\&quot;');**

&#x20;               **const safeImg = p.image || 'https://placehold.co/400x300/e2e8f0/64748b?text=Planta';**

&#x20;               **const buyP = Number(p.buyPrice) || 0;**

&#x20;               **const sellP = Number(p.sellPrice) || (buyP \* 2);**



&#x20;               **const buyPriceHTML = hideBuyPrice ? '' : `**

&#x20;                   **<div>**

&#x20;                       **<span class="text-slate-400 block text-\[10px] uppercase font-semibold">Compra</span>**

&#x20;                       **<span class="font-bold text-slate-800 text-sm">${formatMoney(buyP)}</span>**

&#x20;                   **</div>**

&#x20;               **`;**



&#x20;               **return `**

&#x20;                   **<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col">**

&#x20;                       **<div class="relative h-48 bg-slate-100 cursor-pointer overflow-hidden group" onclick="openZoomImage('${safeImg}', '${safeName}')">**

&#x20;                           **<img src="${safeImg}" alt="${safeName}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" onerror="this.src='https://placehold.co/400x300/e2e8f0/64748b?text=Planta'">**

&#x20;                           **<span class="absolute top-3 left-3 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-lg text-xs font-bold text-slate-800 shadow-xs">**

&#x20;                               **${p.location || 'Interior'}**

&#x20;                           **</span>**

&#x20;                       **</div>**

&#x20;                       **<div class="p-4 flex-1 flex flex-col justify-between space-y-3">**

&#x20;                           **<div>**

&#x20;                               **<span class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">${p.family || 'Sin familia'}</span>**

&#x20;                               **<h3 class="font-bold text-slate-900 text-base leading-snug">${p.name}</h3>**

&#x20;                               **<p class="text-xs text-slate-500 mt-0.5">${p.pot || 'Maceta estándar'} • Act: ${p.updateDate || 'N/D'}</p>**

&#x20;                           **</div>**

&#x20;                           **<div class="bg-slate-50 p-3 rounded-xl border border-slate-100 flex items-center justify-between">**

&#x20;                               **${buyPriceHTML}**

&#x20;                               **<div class="${hideBuyPrice ? 'w-full text-center' : 'text-right'}">**

&#x20;                                   **<span class="text-emerald-600 block text-\[10px] uppercase font-semibold">Venta</span>**

&#x20;                                   **<span class="font-bold text-emerald-700 text-sm">${formatMoney(sellP)}</span>**

&#x20;                               **</div>**

&#x20;                           **</div>**

&#x20;                           **<div class="flex gap-2 pt-1">**

&#x20;                               **<button onclick="editPlant('${p.id}')" class="flex-1 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">Editar</button>**

&#x20;                               **<button onclick="deletePlant('${p.id}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold rounded-xl transition"><i class="fa-solid fa-trash"></i></button>**

&#x20;                           **</div>**

&#x20;                       **</div>**

&#x20;                   **</div>**

&#x20;               **`;**

&#x20;           **}).join('');**

&#x20;       **}**



&#x20;       **// --- RENDER MACETAS Y ACCESORIOS ---**

&#x20;       **function renderItems(type) {**

&#x20;           **const gridId = type === 'pots' ? 'potsGrid' : 'accessoriesGrid';**

&#x20;           **const grid = document.getElementById(gridId);**

&#x20;           **if (!grid) return;**

&#x20;           **const list = dbData\[type] || \[];**



&#x20;           **if (list.length === 0) {**

&#x20;               **grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">No hay elementos registrados.</div>`;**

&#x20;               **return;**

&#x20;           **}**



&#x20;           **grid.innerHTML = list.map(item => {**

&#x20;               **const safeName = (item.name || '').replace(/'/g, "\\'").replace(/"/g, '\&quot;');**

&#x20;               **const safeImg = item.image || 'https://placehold.co/400x300/e2e8f0/64748b?text=Ítem';**

&#x20;               **const buyP = Number(item.buyPrice) || 0;**

&#x20;               **const sellP = Number(item.sellPrice) || (buyP \* 2);**



&#x20;               **const buyPriceHTML = hideBuyPrice ? '' : `**

&#x20;                   **<div>**

&#x20;                       **<span class="text-slate-400 block text-\[10px] uppercase font-semibold">Compra</span>**

&#x20;                       **<span class="font-bold text-slate-800 text-sm">${formatMoney(buyP)}</span>**

&#x20;                   **</div>**

&#x20;               **`;**



&#x20;               **return `**

&#x20;                   **<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col">**

&#x20;                       **<div class="relative h-44 bg-slate-100 cursor-pointer overflow-hidden group" onclick="openZoomImage('${safeImg}', '${safeName}')">**

&#x20;                           **<img src="${safeImg}" alt="${safeName}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">**

&#x20;                       **</div>**

&#x20;                       **<div class="p-4 flex-1 flex flex-col justify-between space-y-3">**

&#x20;                           **<div>**

&#x20;                               **<h3 class="font-bold text-slate-900 text-base leading-snug">${item.name}</h3>**

&#x20;                               **<p class="text-xs text-slate-500 mt-1">📐 Medida: ${item.measure || 'N/A'} | 🧱 Material: ${item.material || 'N/A'}</p>**

&#x20;                           **</div>**

&#x20;                           **<div class="bg-slate-50 p-3 rounded-xl border border-slate-100 flex items-center justify-between">**

&#x20;                               **${buyPriceHTML}**

&#x20;                               **<div class="${hideBuyPrice ? 'w-full text-center' : 'text-right'}">**

&#x20;                                   **<span class="text-emerald-600 block text-\[10px] uppercase font-semibold">Venta</span>**

&#x20;                                   **<span class="font-bold text-emerald-700 text-sm">${formatMoney(sellP)}</span>**

&#x20;                               **</div>**

&#x20;                           **</div>**

&#x20;                           **<div class="flex gap-2 pt-1">**

&#x20;                               **<button onclick="editItem('${type}', '${item.id}')" class="flex-1 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">Editar</button>**

&#x20;                               **<button onclick="deleteItem('${type}', '${item.id}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold rounded-xl"><i class="fa-solid fa-trash"></i></button>**

&#x20;                           **</div>**

&#x20;                       **</div>**

&#x20;                   **</div>**

&#x20;               **`;**

&#x20;           **}).join('');**

&#x20;       **}**



