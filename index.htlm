&#x20;       **function saveChemical(e) {**

&#x20;           **e.preventDefault();**

&#x20;           **const id = document.getElementById('chemicalEditId').value;**

&#x20;           **const name = document.getElementById('chemicalName').value.trim();**

&#x20;           **const type = document.getElementById('chemicalType').value.trim();**

&#x20;           **const application = document.getElementById('chemicalApplication').value.trim();**

&#x20;           **const dilution = document.getElementById('chemicalDilution').value.trim();**

&#x20;           **const measure = document.getElementById('chemicalMeasure').value.trim();**

&#x20;           **const buyPrice = parseFloat(document.getElementById('chemicalBuyPrice').value) || 0;**

&#x20;           **const sellPrice = parseFloat(document.getElementById('chemicalSellPrice').value) || (buyPrice \* 2);**

&#x20;           **const fileInput = document.getElementById('chemicalImageFile');**



&#x20;           **const processSave = (imgUrl) => {**

&#x20;               **if (!dbData.chemicals) dbData.chemicals = \[];**

&#x20;               **if (id) {**

&#x20;                   **const idx = dbData.chemicals.findIndex(x => x.id === id);**

&#x20;                   **if (idx !== -1) {**

&#x20;                       **dbData.chemicals\[idx] = { ...dbData.chemicals\[idx], name, type, application, dilution, measure, buyPrice, sellPrice };**

&#x20;                       **if (imgUrl) dbData.chemicals\[idx].image = imgUrl;**

&#x20;                   **}**

&#x20;               **} else {**

&#x20;                   **dbData.chemicals.push({**

&#x20;                       **id: 'ch\_' + Date.now(), name, type, application, dilution, measure, buyPrice, sellPrice,**

&#x20;                       **image: imgUrl || 'https://images.unsplash.com/photo-1585336261022-6fc0e69de2a3?w=400'**

&#x20;                   **});**

&#x20;               **}**

&#x20;               **saveDb();**

&#x20;               **closeChemicalModal();**

&#x20;               **renderChemicals();**

&#x20;           **};**



&#x20;           **if (fileInput \&\& fileInput.files \&\& fileInput.files\[0]) {**

&#x20;               **const reader = new FileReader();**

&#x20;               **reader.onload = function(evt) { processSave(evt.target.result); };**

&#x20;               **reader.readAsDataURL(fileInput.files\[0]);**

&#x20;           **} else {**

&#x20;               **processSave(id ? null : 'https://images.unsplash.com/photo-1585336261022-6fc0e69de2a3?w=400');**

&#x20;           **}**

&#x20;       **}**



