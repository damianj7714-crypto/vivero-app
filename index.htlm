**<!DOCTYPE html>**

**<html lang="es" class="h-full">**

**<head>**

&#x20;   **<meta charset="UTF-8">**

&#x20;   **<meta name="viewport" content="width=device-width, initial-scale=1.0">**

&#x20;   **<title>ViveroApp - Gestión Profesional de Viveros</title>**

&#x20;   **<!-- Tailwind CSS -->**

&#x20;   **<script src="https://cdn.tailwindcss.com"></script>**

&#x20;   **<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700\&display=swap" rel="stylesheet">**

&#x20;   **<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">**

&#x20;   **<!-- SheetJS for Excel handling -->**

&#x20;   **<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>**

&#x20;   **<!-- Firebase SDKs -->**

&#x20;   **<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>**

&#x20;   **<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>**

&#x20;   **<style>** 

&#x20;       **body { font-family: 'Plus Jakarta Sans', sans-serif; }** 

&#x20;       **.custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }**

&#x20;       **.custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }**

&#x20;       **.custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }**

&#x20;       **.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }**

&#x20;   **</style>**

**</head>**

**<body class="bg-slate-50 text-slate-800 min-h-full flex flex-col selection:bg-emerald-500 selection:text-white">**



&#x20;   **<!-- HEADER -->**

&#x20;   **<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">**

&#x20;       **<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">**

&#x20;           **<div class="flex items-center space-x-3">**

&#x20;               **<div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white text-lg shadow-md shadow-emerald-200">**

&#x20;                   **<i class="fa-solid fa-seedling"></i>**

&#x20;               **</div>**

&#x20;               **<div>**

&#x20;                   **<h1 class="font-bold text-slate-900 text-lg leading-tight">ViveroApp</h1>**

&#x20;                   **<p class="text-xs text-emerald-600 font-medium">Gestión Profesional (Precios en pesos $)</p>**

&#x20;               **</div>**

&#x20;           **</div>**



&#x20;           **<!-- TOGGLE PRECIO COMPRA \& FIREBASE BUTTONS -->**

&#x20;           **<div class="flex items-center space-x-2 sm:space-x-4">**

&#x20;               **<div class="flex items-center gap-2 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200">**

&#x20;                   **<span class="text-xs font-semibold text-slate-600 hidden md:inline">Ocultar Costos</span>**

&#x20;                   **<button id="toggleBuyPriceBtn" onclick="requestToggleBuyPrice()" class="w-11 h-6 bg-slate-300 rounded-full p-1 transition-colors duration-200 ease-in-out relative flex items-center" title="Cambiar visibilidad de precios de compra">**

&#x20;                       **<div id="toggleBuyPriceCircle" class="w-4 h-4 bg-white rounded-full shadow-md transform transition-transform duration-200 ease-in-out translate-x-0"></div>**

&#x20;                   **</button>**

&#x20;               **</div>**



&#x20;               **<button onclick="openFirebaseModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-sky-50 hover:bg-sky-100 text-sky-700 text-xs font-semibold rounded-lg transition">**

&#x20;                   **<i class="fa-solid fa-cloud-arrow-up"></i>**

&#x20;                   **<span class="hidden sm:inline">Configurar Firebase</span>**

&#x20;               **</button>**

&#x20;               **<div onclick="openFirebaseDiagnosticsModal()" class="flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-xl border border-slate-200 cursor-pointer transition" title="Ver Estado de Sincronización">**

&#x20;                   **<div id="statusDot" class="w-2.5 h-2.5 rounded-full bg-amber-500"></div>**

&#x20;                   **<span id="connectionStatus" class="text-xs font-semibold text-slate-600 hidden lg:inline">Local (Sin Firebase)</span>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;       **</div>**

&#x20;   **</header>**



&#x20;   **<!-- NAVIGATION TABS -->**

&#x20;   **<nav class="bg-white border-b border-slate-200 shadow-xs">**

&#x20;       **<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto space-x-2 sm:space-x-6 py-2">**

&#x20;           **<button onclick="switchTab('plants')" id="tab-plants" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-emerald-600 text-white shadow-sm shadow-emerald-200 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-leaf"></i> Plantas**

&#x20;           **</button>**

&#x20;           **<button onclick="switchTab('pots')" id="tab-pots" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-circle"></i> Macetas**

&#x20;           **</button>**

&#x20;           **<button onclick="switchTab('accessories')" id="tab-accessories" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-tools"></i> Accesorios**

&#x20;           **</button>**

&#x20;           **<button onclick="switchTab('chemicals')" id="tab-chemicals" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-flask"></i> Químicos**

&#x20;           **</button>**

&#x20;           **<button onclick="switchTab('soils')" id="tab-soils" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-jar"></i> Tierras**

&#x20;           **</button>**

&#x20;           **<button onclick="switchTab('bot')" id="tab-bot" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-robot"></i> Bot de Plantas**

&#x20;           **</button>**

&#x20;           **<button onclick="switchTab('sales')" id="tab-sales" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-slate-100 flex items-center gap-2 whitespace-nowrap">**

&#x20;               **<i class="fa-solid fa-cash-register"></i> Ventas \& Caja**

&#x20;           **</button>**

&#x20;       **</div>**

&#x20;   **</nav>**



&#x20;   **<!-- MAIN CONTENT -->**

&#x20;   **<main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">**



&#x20;       **<!-- PLANTS TAB -->**

&#x20;       **<section id="section-plants" class="space-y-6">**

&#x20;           **<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">**

&#x20;               **<div>**

&#x20;                   **<h2 class="text-xl font-bold text-slate-900">Catálogo de Plantas</h2>**

&#x20;                   **<p class="text-xs sm:text-sm text-slate-500">Gestiona tus plantas y precios (expresados en pesos $).</p>**

&#x20;               **</div>**

&#x20;               **<div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">**

&#x20;                   **<button onclick="openExcelModal('plants')" class="flex-1 sm:flex-none px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-file-excel"></i> Importar Excel**

&#x20;                   **</button>**

&#x20;                   **<button onclick="openPlantModal()" class="flex-1 sm:flex-none px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-plus"></i> Nueva Planta**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;           **</div>**



&#x20;           **<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">**

&#x20;               **<div class="flex items-center gap-2">**

&#x20;                   **<div class="relative flex-1">**

&#x20;                       **<i class="fa-solid fa-search absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>**

&#x20;                       **<input type="text" id="plantSearch" oninput="renderPlants()" placeholder="Buscar por nombre o familia..." class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<button onclick="openCameraModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white p-2.5 rounded-xl transition shadow-sm flex items-center justify-center gap-2 text-sm font-medium whitespace-nowrap" title="Buscar por foto">**

&#x20;                       **<i class="fa-solid fa-camera"></i>**

&#x20;                       **<span class="hidden sm:inline">Buscar por foto</span>**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;               **<select id="plantFilterLocation" onchange="renderPlants()" class="w-full py-2.5 px-3 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **<option value="">Todas las ubicaciones</option>**

&#x20;                   **<option value="Interior">Interior</option>**

&#x20;                   **<option value="Exterior">Exterior</option>**

&#x20;                   **<option value="Interior / Exterior">Interior / Exterior</option>**

&#x20;               **</select>**

&#x20;           **</div>**



&#x20;           **<div id="plantsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>**

&#x20;       **</section>**



&#x20;       **<!-- POTS TAB -->**

&#x20;       **<section id="section-pots" class="space-y-6 hidden">**

&#x20;           **<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">**

&#x20;               **<div>**

&#x20;                   **<h2 class="text-xl font-bold text-slate-900">Macetas y Contenedores</h2>**

&#x20;                   **<p class="text-xs sm:text-sm text-slate-500">Catálogo y precios de macetas (en $).</p>**

&#x20;               **</div>**

&#x20;               **<div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">**

&#x20;                   **<button onclick="openExcelModal('pots')" class="flex-1 sm:flex-none px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-file-excel"></i> Importar Excel**

&#x20;                   **</button>**

&#x20;                   **<button onclick="openItemModal('pots')" class="flex-1 sm:flex-none px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-plus"></i> Nueva Maceta**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;           **<div id="potsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>**

&#x20;       **</section>**



&#x20;       **<!-- ACCESSORIES TAB -->**

&#x20;       **<section id="section-accessories" class="space-y-6 hidden">**

&#x20;           **<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">**

&#x20;               **<div>**

&#x20;                   **<h2 class="text-xl font-bold text-slate-900">Accesorios y Herramientas</h2>**

&#x20;                   **<p class="text-xs sm:text-sm text-slate-500">Palas, guantes, tutores (en $).</p>**

&#x20;               **</div>**

&#x20;               **<div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">**

&#x20;                   **<button onclick="openExcelModal('accessories')" class="flex-1 sm:flex-none px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-file-excel"></i> Importar Excel**

&#x20;                   **</button>**

&#x20;                   **<button onclick="openItemModal('accessories')" class="flex-1 sm:flex-none px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-plus"></i> Nuevo Accesorio**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;           **<div id="accessoriesGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>**

&#x20;       **</section>**



&#x20;       **<!-- CHEMICALS TAB -->**

&#x20;       **<section id="section-chemicals" class="space-y-6 hidden">**

&#x20;           **<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">**

&#x20;               **<div>**

&#x20;                   **<h2 class="text-xl font-bold text-slate-900">Fertilizantes y Químicos</h2>**

&#x20;                   **<p class="text-xs sm:text-sm text-slate-500">Abonos, plaguicidas y productos químicos (en $).</p>**

&#x20;               **</div>**

&#x20;               **<div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">**

&#x20;                   **<button onclick="openExcelModal('chemicals')" class="flex-1 sm:flex-none px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-file-excel"></i> Importar Excel**

&#x20;                   **</button>**

&#x20;                   **<button onclick="openChemicalModal()" class="flex-1 sm:flex-none px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-plus"></i> Nuevo Químico**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;           **<div id="chemicalsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>**

&#x20;       **</section>**



&#x20;       **<!-- SOILS TAB (TIERRAS) -->**

&#x20;       **<section id="section-soils" class="space-y-6 hidden">**

&#x20;           **<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">**

&#x20;               **<div>**

&#x20;                   **<h2 class="text-xl font-bold text-slate-900">Tierras y Sustratos</h2>**

&#x20;                   **<p class="text-xs sm:text-sm text-slate-500">Catálogo de tierras, compost y sustratos (en $).</p>**

&#x20;               **</div>**

&#x20;               **<div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">**

&#x20;                   **<button onclick="openExcelModal('soils')" class="flex-1 sm:flex-none px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-file-excel"></i> Importar Excel**

&#x20;                   **</button>**

&#x20;                   **<button onclick="openSoilModal()" class="flex-1 sm:flex-none px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                       **<i class="fa-solid fa-plus"></i> Nueva Tierra**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;           **<div id="soilsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>**

&#x20;       **</section>**



&#x20;       **<!-- BOT TAB -->**

&#x20;       **<section id="section-bot" class="space-y-6 hidden">**

&#x20;           **<div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">**

&#x20;               **<h2 class="text-xl font-bold text-slate-900">Bot Experto en Plantas</h2>**

&#x20;               **<p class="text-xs sm:text-sm text-slate-500">Consulta cuidados, riego, plagas y genera recomendaciones al instante.</p>**

&#x20;           **</div>**

&#x20;           **<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">**

&#x20;               **<div class="flex gap-2">**

&#x20;                   **<input type="text" id="botQuery" placeholder="Ej: ¿Cómo revivir un helecho marchito?" class="flex-1 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **<button onclick="askBot()" id="botSendBtn" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-xl transition flex items-center gap-2">**

&#x20;                       **<i class="fa-solid fa-paper-plane"></i> Consultar**

&#x20;                   **</button>**

&#x20;               **</div>**

&#x20;               **<div id="botResult" class="hidden p-5 bg-emerald-50/60 border border-emerald-100 rounded-2xl space-y-4">**

&#x20;                   **<h3 class="font-bold text-emerald-900 flex items-center gap-2">**

&#x20;                       **<i class="fa-solid fa-robot text-emerald-600"></i> Respuesta del Bot:**

&#x20;                   **</h3>**

&#x20;                   **<div id="botAnswerText" class="text-sm text-slate-700 leading-relaxed whitespace-pre-line"></div>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;       **</section>**



&#x20;       **<!-- SALES TAB -->**

&#x20;       **<section id="section-sales" class="space-y-6 hidden">**

&#x20;           **<div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">**

&#x20;               **<div>**

&#x20;                   **<h2 class="text-xl font-bold text-slate-900">Registro de Ventas y Caja</h2>**

&#x20;                   **<p class="text-xs sm:text-sm text-slate-500">Control de ingresos y transacciones (valores expresados en pesos $).</p>**

&#x20;               **</div>**

&#x20;               **<button onclick="openSaleModal()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center justify-center gap-2">**

&#x20;                   **<i class="fa-solid fa-cash-register"></i> Registrar Venta**

&#x20;               **</button>**

&#x20;           **</div>**

&#x20;           **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;               **<div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">**

&#x20;                   **<div>**

&#x20;                       **<p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ventas Totales</p>**

&#x20;                       **<h3 id="totalSalesAmount" class="text-2xl font-bold text-slate-900 mt-1">$0</h3>**

&#x20;                   **</div>**

&#x20;                   **<div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">**

&#x20;                       **<i class="fa-solid fa-wallet"></i>**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">**

&#x20;                   **<div>**

&#x20;                       **<p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Transacciones</p>**

&#x20;                       **<h3 id="totalSalesCount" class="text-2xl font-bold text-slate-900 mt-1">0</h3>**

&#x20;                   **</div>**

&#x20;                   **<div class="w-12 h-12 bg-sky-50 text-sky-600 rounded-xl flex items-center justify-center text-xl">**

&#x20;                       **<i class="fa-solid fa-receipt"></i>**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;           **<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">**

&#x20;               **<div class="p-4 border-b border-slate-100 font-bold text-slate-900 text-sm">Historial de Ventas</div>**

&#x20;               **<div class="overflow-x-auto">**

&#x20;                   **<table class="w-full text-left text-sm">**

&#x20;                       **<thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">**

&#x20;                           **<tr>**

&#x20;                               **<th class="p-4">Fecha</th>**

&#x20;                               **<th class="p-4">Producto / Ítem</th>**

&#x20;                               **<th class="p-4">Cantidad</th>**

&#x20;                               **<th class="p-4">Total</th>**

&#x20;                               **<th class="p-4 text-right">Acciones</th>**

&#x20;                           **</tr>**

&#x20;                       **</thead>**

&#x20;                       **<tbody id="salesTableBody" class="divide-y divide-slate-100"></tbody>**

&#x20;                   **</table>**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;       **</section>**



&#x20;   **</main>**



&#x20;   **<!-- EXCEL IMPORT MODAL GENERAL -->**

&#x20;   **<div id="excelModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-5 my-8">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 id="excelModalTitle" class="font-bold text-slate-900 text-lg flex items-center gap-2">**

&#x20;                   **<i class="fa-solid fa-file-excel text-sky-600"></i> Importar Ítems desde Excel / CSV**

&#x20;               **</h3>**

&#x20;               **<button onclick="closeExcelModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<div class="space-y-4 text-sm text-slate-600">**

&#x20;               **<p id="excelModalDescription">Sube tu archivo Excel (`.xlsx` o `.csv`) con las columnas correspondientes (el precio de venta se calcula automáticamente al doble del precio de compra).</p>**

&#x20;               **<button onclick="downloadExcelTemplate()" class="px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold rounded-xl transition flex items-center gap-2">**

&#x20;                   **<i class="fa-solid fa-download"></i> Descargar Plantilla de Ejemplo**

&#x20;               **</button>**

&#x20;               **<div class="border-2 border-dashed border-slate-200 hover:border-sky-500 rounded-2xl p-6 text-center transition cursor-pointer bg-slate-50/50" onclick="document.getElementById('excelFileInput').click()">**

&#x20;                   **<i class="fa-solid fa-cloud-arrow-up text-3xl text-sky-500 mb-2"></i>**

&#x20;                   **<p class="font-semibold text-slate-800 text-sm">Haz clic aquí o arrastra tu archivo</p>**

&#x20;                   **<input type="file" id="excelFileInput" accept=".xlsx, .xls, .csv" onchange="handleExcelUpload(event)" class="hidden">**

&#x20;               **</div>**

&#x20;           **</div>**

&#x20;           **<div class="pt-2 flex justify-end">**

&#x20;               **<button onclick="closeExcelModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">Cerrar</button>**

&#x20;           **</div>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<!-- CAMERA SEARCH MODAL -->**

&#x20;   **<div id="modalCameraSearch" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 my-8 relative">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">**

&#x20;                   **<i class="fa-solid fa-camera text-emerald-600"></i> Buscar Planta por Foto**

&#x20;               **</h3>**

&#x20;               **<button onclick="closeCameraModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<div class="flex flex-col items-center justify-center border-2 border-dashed border-slate-200 rounded-2xl p-4 bg-slate-50 space-y-3">**

&#x20;               **<img id="cameraImagePreview" src="" class="hidden max-h-48 rounded-xl object-cover shadow-xs border border-slate-200">**

&#x20;               **<input type="file" id="cameraInput" accept="image/\*" capture="environment" class="hidden" onchange="handleCameraImageSelected(event)">**

&#x20;               **<button onclick="document.getElementById('cameraInput').click()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-semibold text-xs shadow-xs transition flex items-center gap-2">**

&#x20;                   **<i class="fa-solid fa-camera"></i> Tomar Foto / Cargar Imagen**

&#x20;               **</button>**

&#x20;           **</div>**

&#x20;           **<div id="cameraSearchResultsContainer" class="max-h-48 overflow-y-auto space-y-2">**

&#x20;               **<p class="text-center text-xs text-slate-500">Toma o sube una foto para comparar con el catálogo de tu base de datos.</p>**

&#x20;           **</div>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<!-- FIREBASE CONFIG MODAL -->**

&#x20;   **<div id="firebaseModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 my-8">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">**

&#x20;                   **<i class="fa-solid fa-cloud text-emerald-600"></i> Conectar con Firebase Cloud**

&#x20;               **</h3>**

&#x20;               **<button onclick="closeFirebaseModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<p class="text-xs text-slate-600 leading-relaxed">**

&#x20;               **Ingresa las credenciales de tu proyecto Firebase. Asegúrate de tener activa la base de datos Firestore en tu <a href="https://console.firebase.google.com" target="\_blank" class="text-emerald-600 underline font-semibold">Firebase Console</a>.**

&#x20;           **</p>**

&#x20;           **<form id="firebaseForm" onsubmit="saveFirebaseConfig(event)" class="space-y-3">**

&#x20;               **<div>**

&#x20;                   **<label class="block text-xs font-semibold text-slate-700 mb-1">apiKey</label>**

&#x20;                   **<input type="text" id="fbApiKey" placeholder="AIzaSy..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono">**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-2 gap-2">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">authDomain</label>**

&#x20;                       **<input type="text" id="fbAuthDomain" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">projectId</label>**

&#x20;                       **<input type="text" id="fbProjectId" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-2 gap-2">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">storageBucket</label>**

&#x20;                       **<input type="text" id="fbStorageBucket" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">messagingSenderId</label>**

&#x20;                       **<input type="text" id="fbMessagingSenderId" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div>**

&#x20;                   **<label class="block text-xs font-semibold text-slate-700 mb-1">appId</label>**

&#x20;                   **<input type="text" id="fbAppId" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono">**

&#x20;               **</div>**

&#x20;               **<div class="pt-2 flex justify-between items-center">**

&#x20;                   **<button type="button" onclick="disconnectFirebase()" class="text-rose-600 hover:underline text-xs font-semibold">Desconectar</button>**

&#x20;                   **<div class="flex gap-2">**

&#x20;                       **<button type="button" onclick="closeFirebaseModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">Cancelar</button>**

&#x20;                       **<button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm">Guardar y Conectar</button>**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;           **</form>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<!-- FIREBASE DIAGNOSTICS MODAL -->**

&#x20;   **<div id="firebaseDiagnosticsModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 my-8">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">**

&#x20;                   **<i class="fa-solid fa-circle-info text-sky-600"></i> Estado de Sincronización**

&#x20;               **</h3>**

&#x20;               **<button onclick="closeFirebaseDiagnosticsModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<div class="space-y-3 text-sm">**

&#x20;               **<div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-2">**

&#x20;                   **<div class="flex justify-between items-center">**

&#x20;                       **<span class="text-xs text-slate-500 font-medium">Estado actual:</span>**

&#x20;                       **<span id="diagStatusBadge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Modo Local</span>**

&#x20;                   **</div>**

&#x20;                   **<div class="flex justify-between items-center">**

&#x20;                       **<span class="text-xs text-slate-500 font-medium">Proyecto ID:</span>**

&#x20;                       **<span id="diagProjectId" class="text-xs font-mono font-semibold text-slate-800">viveromorlina</span>**

&#x20;                   **</div>**

&#x20;                   **<div class="flex justify-between items-center">**

&#x20;                       **<span class="text-xs text-slate-500 font-medium">Última sincronización:</span>**

&#x20;                       **<span id="diagLastSync" class="text-xs font-medium text-slate-700">Nunca</span>**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<p id="diagDetails" class="text-xs text-slate-600 leading-relaxed">**

&#x20;                   **Sincronización en tiempo real configurada con Firebase Cloud.**

&#x20;               **</p>**

&#x20;           **</div>**

&#x20;           **<div class="pt-2 flex justify-end gap-2">**

&#x20;               **<button onclick="closeFirebaseDiagnosticsModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">Cerrar</button>**

&#x20;           **</div>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<!-- PLANT MODAL -->**

&#x20;   **<div id="plantModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 my-8">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 id="plantModalTitle" class="font-bold text-slate-900 text-lg">Nueva Planta</h3>**

&#x20;               **<button onclick="closePlantModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<form id="plantForm" onsubmit="savePlant(event)" class="space-y-4">**

&#x20;               **<input type="hidden" id="plantEditId">**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Nombre Común \*</label>**

&#x20;                       **<input type="text" id="plantName" required placeholder="Ej: Monstera Deliciosa" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Familia / Especie</label>**

&#x20;                       **<input type="text" id="plantFamily" placeholder="Ej: Araceae" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Ubicación</label>**

&#x20;                       **<select id="plantLocation" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                           **<option value="Interior">Interior</option>**

&#x20;                           **<option value="Exterior">Exterior</option>**

&#x20;                           **<option value="Interior / Exterior">Interior / Exterior</option>**

&#x20;                       **</select>**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Tipo de Maceta</label>**

&#x20;                       **<input type="text" id="plantPot" placeholder="Ej: Maceta N° 14" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Precio Compra ($)</label>**

&#x20;                       **<input type="number" id="plantBuyPrice" min="0" step="100" value="8000" required oninput="autoUpdatePlantSell()" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Precio Venta ($)</label>**

&#x20;                       **<input type="number" id="plantSellPrice" min="0" step="100" value="16000" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Fecha Actualización</label>**

&#x20;                       **<input type="date" id="plantUpdateDate" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Imagen (Archivo local)</label>**

&#x20;                       **<input type="file" id="plantImageFile" accept="image/\*" class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="pt-4 flex justify-end gap-2">**

&#x20;                   **<button type="button" onclick="closePlantModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">Cancelar</button>**

&#x20;                   **<button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm transition">Guardar Planta</button>**

&#x20;               **</div>**

&#x20;           **</form>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<!-- GENERAL ITEM MODAL (MACETAS Y ACCESORIOS CON MEDIDA Y MATERIAL) -->**

&#x20;   **<div id="itemModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 my-8">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 id="itemModalTitle" class="font-bold text-slate-900 text-lg">Nuevo Ítem</h3>**

&#x20;               **<button onclick="closeItemModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<form id="itemForm" onsubmit="saveItem(event)" class="space-y-4">**

&#x20;               **<input type="hidden" id="itemType">**

&#x20;               **<input type="hidden" id="itemEditId">**

&#x20;               **<div>**

&#x20;                   **<label class="block text-xs font-semibold text-slate-700 mb-1">Nombre \*</label>**

&#x20;                   **<input type="text" id="itemName" required placeholder="Ej: Maceta N° 12" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Medida 📐</label>**

&#x20;                       **<input type="text" id="itemMeasure" placeholder="Ej: 20cm / N° 14" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Material 🧱</label>**

&#x20;                       **<input type="text" id="itemMaterial" placeholder="Ej: Plástico / Plástico reforzado" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Precio Compra ($)</label>**

&#x20;                       **<input type="number" id="itemBuyPrice" min="0" step="100" value="2000" required oninput="autoUpdateItemSell()" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Precio Venta ($)</label>**

&#x20;                       **<input type="number" id="itemSellPrice" min="0" step="100" value="4000" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;               **</div>**

&#x20;               **<div>**

&#x20;                   **<label class="block text-xs font-semibold text-slate-700 mb-1">Imagen (Archivo local)</label>**

&#x20;                   **<input type="file" id="itemImageFile" accept="image/\*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">**

&#x20;               **</div>**

&#x20;               **<div class="pt-4 flex justify-end gap-2">**

&#x20;                   **<button type="button" onclick="closeItemModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">Cancelar</button>**

&#x20;                   **<button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm transition">Guardar</button>**

&#x20;               **</div>**

&#x20;           **</form>**

&#x20;       **</div>**

&#x20;   **</div>**



&#x20;   **<!-- MODAL CHEMICALS (QUÍMICOS CON TODOS LOS CAMPOS) -->**

&#x20;   **<div id="chemicalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4 overflow-y-auto">**

&#x20;       **<div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 my-8">**

&#x20;           **<div class="flex justify-between items-center border-b border-slate-100 pb-3">**

&#x20;               **<h3 id="chemicalModalTitle" class="font-bold text-slate-900 text-lg">Nuevo Químico</h3>**

&#x20;               **<button onclick="closeChemicalModal()" class="text-slate-400 hover:text-slate-600 text-lg p-1"><i class="fa-solid fa-xmark"></i></button>**

&#x20;           **</div>**

&#x20;           **<form id="chemicalForm" onsubmit="saveChemical(event)" class="space-y-4">**

&#x20;               **<input type="hidden" id="chemicalEditId">**

&#x20;               **<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Nombre \*</label>**

&#x20;                       **<input type="text" id="chemicalName" required placeholder="Ej: Fertilizante Líquido" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">**

&#x20;                   **</div>**

&#x20;                   **<div>**

&#x20;                       **<label class="block text-xs font-semibold text-slate-700 mb-1">Tipo 🏷️</label>**

