&#x20;                   **const idx = dbData\[type].findIndex(x => x.id === id);**

&#x20;                   **if (idx !== -1) {**

&#x20;                       **dbData\[type]\[idx] = { ...dbData\[type]\[idx], name, measure, material, buyPrice, sellPrice };**

&#x20;                       **if (imgUrl) dbData\[type]\[idx].image = imgUrl;**

&#x20;                   **}**

&#x20;               **} else {**

&#x20;                   **dbData\[type].push({**

&#x20;                       **id: type\[0] + '\_' + Date.now(), name, measure, material, buyPrice, sellPrice,**

&#x20;                       **image: imgUrl || 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=400'**

&#x20;                   **});**

&#x20;               **}**

&#x20;               **saveDb();**

&#x20;               **closeItemModal();**

&#x20;               **renderItems(type);**

&#x20;           **};**



&#x20;           **if (fileInput \&\& fileInput.files \&\& fileInput.files\[0]) {**

&#x20;               **const reader = new FileReader();**

&#x20;               **reader.onload = function(evt) { processSave(evt.target.result); };**

&#x20;               **reader.readAsDataURL(fileInput.files\[0]);**

&#x20;           **} else {**

&#x20;               **processSave(id ? null : 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=400');**

&#x20;           **}**

&#x20;       **}**



