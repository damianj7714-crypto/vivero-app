&#x20;               **renderItems(type);**

&#x20;           **});**

&#x20;       **}**



&#x20;       **// --- IMPORTACIÓN EXCEL GENERAL ---**

&#x20;       **function openExcelModal(category = 'plants') {**

&#x20;           **currentExcelCategory = category;**

&#x20;           **const titleEl = document.getElementById('excelModalTitle');**

&#x20;           **const descEl = document.getElementById('excelModalDescription');**

&#x20;           **const categoryNames = { plants: 'Plantas', pots: 'Macetas', accessories: 'Accesorios', chemicals: 'Químicos', soils: 'Tierras' };**



&#x20;           **if (titleEl) titleEl.innerHTML = `<i class="fa-solid fa-file-excel text-sky-600"></i> Importar ${categoryNames\[category]} desde Excel / CSV`;**

&#x20;           **if (descEl) {**

&#x20;               **if (category === 'plants') {**

&#x20;                   **descEl.innerHTML = 'Columnas requeridas: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs font-semibold text-slate-800">Nombre, Familia, Ubicacion, Maceta, PrecioCompra, FechaActualizacion, Imagen</code>';**

&#x20;               **} else if (category === 'pots' || category === 'accessories') {**

&#x20;                   **descEl.innerHTML = 'Columnas requeridas: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs font-semibold text-slate-800">Nombre, Medida, Material, PrecioCompra, Imagen</code>';**

&#x20;               **} else if (category === 'chemicals') {**

&#x20;                   **descEl.innerHTML = 'Columnas requeridas: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs font-semibold text-slate-800">Nombre, Tipo, Aplicacion, Disolucion, Medida, PrecioCompra, Imagen</code>';**

&#x20;               **} else if (category === 'soils') {**

&#x20;                   **descEl.innerHTML = 'Columnas requeridas: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs font-semibold text-slate-800">Nombre, Marca, Tipo, Medida, PrecioCompra, Imagen</code>';**

&#x20;               **}**

&#x20;           **}**



&#x20;           **document.getElementById('excelModal').classList.remove('hidden');**

&#x20;       **}**



&#x20;       **function closeExcelModal() { document.getElementById('excelModal').classList.add('hidden'); }**



&#x20;       **function downloadExcelTemplate() {**

&#x20;           **let templateData = \[];**

&#x20;           **let fileName = `Plantilla\_${currentExcelCategory}.xlsx`;**



&#x20;           **if (currentExcelCategory === 'plants') {**

&#x20;               **templateData = \[{ Nombre: "Monstera Deliciosa", Familia: "Araceae", Ubicacion: "Interior", Maceta: "Maceta N° 16", PrecioCompra: 8000, FechaActualizacion: "2026-03-05", Imagen: "https://images.unsplash.com/photo-1614594975525-e45190c55d0b?w=400" }];**

&#x20;           **} else if (currentExcelCategory === 'pots' || currentExcelCategory === 'accessories') {**

&#x20;               **templateData = \[{ Nombre: "Ejemplo Ítem", Medida: "N° 14", Material: "Plástico", PrecioCompra: 2000, Imagen: "https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=400" }];**

&#x20;           **} else if (currentExcelCategory === 'chemicals') {**

&#x20;               **templateData = \[{ Nombre: "Fertilizante Líquido", Tipo: "Fertilizante", Aplicacion: "Riego", Disolucion: "5ml/L", Medida: "250cc", PrecioCompra: 4000, Imagen: "https://images.unsplash.com/photo-1585336261022-6fc0e69de2a3?w=400" }];**

&#x20;           **} else if (currentExcelCategory === 'soils') {**

&#x20;               **templateData = \[{ Nombre: "Tierra Preparada", Marca: "TerraFertil", Tipo: "Tierra Preparada", Medida: "10 Litros", PrecioCompra: 3000, Imagen: "https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400" }];**

&#x20;           **}**



&#x20;           **const ws = XLSX.utils.json\_to\_sheet(templateData);**

&#x20;           **const wb = XLSX.utils.book\_new();**

&#x20;           **XLSX.utils.book\_append\_sheet(wb, ws, "Datos");**

&#x20;           **XLSX.writeFile(wb, fileName);**

&#x20;       **}**



&#x20;       **function handleExcelUpload(e) {**

&#x20;           **const file = e.target.files\[0];**

&#x20;           **if (!file) return;**

&#x20;           **const reader = new FileReader();**

&#x20;           **reader.onload = function(evt) {**

&#x20;               **try {**

&#x20;                   **const data = new Uint8Array(evt.target.result);**

&#x20;                   **const workbook = XLSX.read(data, { type: 'array' });**

&#x20;                   **const worksheet = workbook.Sheets\[workbook.SheetNames\[0]];**

&#x20;                   **const json = XLSX.utils.sheet\_to\_json(worksheet);**



&#x20;                   **let count = 0;**

&#x20;                   **json.forEach(row => {**

&#x20;                       **const name = row.Nombre || row.nombre || row.NAME;**

&#x20;                       **if (name) {**

&#x20;                           **let rawBuy = row.PrecioCompra || row.preciocompra || row.Precio || row.precio || 2000;**

&#x20;                           **if (typeof rawBuy === 'string') rawBuy = rawBuy.replace(/\[^0-9,.-]/g, '').replace(',', '.');**

&#x20;                           **const buy = parseFloat(rawBuy) || 2000;**

&#x20;                           **const imgUrl = row.Imagen || row.imagen || row.IMAGE || row.foto || row.Foto;**



&#x20;                           **if (!dbData\[currentExcelCategory]) dbData\[currentExcelCategory] = \[];**



&#x20;                           **if (currentExcelCategory === 'plants') {**

&#x20;                               **dbData.plants.push({**

&#x20;                                   **id: 'p\_ex\_' + Date.now() + Math.random().toString(36).substr(2, 4),**

&#x20;                                   **name: String(name),**

&#x20;                                   **family: String(row.Familia || row.familia || ''),**

&#x20;                                   **location: String(row.Ubicacion || row.ubicacion || 'Interior'),**

&#x20;                                   **pot: String(row.Maceta || row.maceta || ''),**

&#x20;                                   **buyPrice: buy,**

&#x20;                                   **sellPrice: buy \* 2,**

&#x20;                                   **updateDate: String(row.FechaActualizacion || row.fechaactualizacion || new Date().toISOString().split('T')\[0]),**

&#x20;                                   **image: (imgUrl \&\& String(imgUrl).startsWith('http')) ? String(imgUrl) : 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=400'**

&#x20;                               **});**

&#x20;                           **} else if (currentExcelCategory === 'pots' || currentExcelCategory === 'accessories') {**

&#x20;                               **dbData\[currentExcelCategory].push({**

&#x20;                                   **id: currentExcelCategory\[0] + '\_ex\_' + Date.now() + Math.random().toString(36).substr(2, 4),**

&#x20;                                   **name: String(name),**

&#x20;                                   **measure: String(row.Medida || row.medida || ''),**

&#x20;                                   **material: String(row.Material || row.material || ''),**

&#x20;                                   **buyPrice: buy,**

&#x20;                                   **sellPrice: buy \* 2,**

&#x20;                                   **image: (imgUrl \&\& String(imgUrl).startsWith('http')) ? String(imgUrl) : 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=400'**

&#x20;                               **});**

&#x20;                           **} else if (currentExcelCategory === 'chemicals') {**

&#x20;                               **dbData.chemicals.push({**

&#x20;                                   **id: 'ch\_ex\_' + Date.now() + Math.random().toString(36).substr(2, 4),**

&#x20;                                   **name: String(name),**

&#x20;                                   **type: String(row.Tipo || row.tipo || ''),**

&#x20;                                   **application: String(row.Aplicacion || row.aplicacion || ''),**

&#x20;                                   **dilution: String(row.Disolucion || row.disolucion || ''),**

&#x20;                                   **measure: String(row.Medida || row.medida || ''),**

&#x20;                                   **buyPrice: buy,**

&#x20;                                   **sellPrice: buy \* 2,**

&#x20;                                   **image: (imgUrl \&\& String(imgUrl).startsWith('http')) ? String(imgUrl) : 'https://images.unsplash.com/photo-1585336261022-6fc0e69de2a3?w=400'**

&#x20;                               **});**

&#x20;                           **} else if (currentExcelCategory === 'soils') {**

&#x20;                               **dbData.soils.push({**

&#x20;                                   **id: 'sl\_ex\_' + Date.now() + Math.random().toString(36).substr(2, 4),**

&#x20;                                   **name: String(name),**

&#x20;                                   **brand: String(row.Marca || row.marca || ''),**

&#x20;                                   **type: String(row.Tipo || row.tipo || 'Tierra Preparada'),**

&#x20;                                   **measure: String(row.Medida || row.medida || ''),**

&#x20;                                   **buyPrice: buy,**

&#x20;                                   **sellPrice: buy \* 2,**

&#x20;                                   **image: (imgUrl \&\& String(imgUrl).startsWith('http')) ? String(imgUrl) : 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400'**

&#x20;                               **});**

&#x20;                           **}**

&#x20;                           **count++;**

&#x20;                       **}**

&#x20;                   **});**

&#x20;                   **saveDb();**

&#x20;                   **closeExcelModal();**

&#x20;                   **renderCurrentTab();**

&#x20;                   **alert(`¡Se importaron ${count} elementos exitosamente!`);**

&#x20;               **} catch(err) {**

&#x20;                   **alert('Error al procesar el archivo Excel.');**

&#x20;               **}**

&#x20;           **};**

&#x20;           **reader.readAsArrayBuffer(file);**

&#x20;       **}**



&#x20;       **// --- BOT DE PLANTAS ---**

&#x20;       **async function askBot() {**

&#x20;           **const queryInput = document.getElementById('botQuery');**

&#x20;           **const query = queryInput ? queryInput.value.trim() : '';**

&#x20;           **if (!query) return;**

&#x20;           **const btn = document.getElementById('botSendBtn');**

&#x20;           **const resultBox = document.getElementById('botResult');**

&#x20;           **const answerText = document.getElementById('botAnswerText');**



&#x20;           **if (btn) {**

&#x20;               **btn.disabled = true;**

&#x20;               **btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Consultando...`;**

&#x20;           **}**



&#x20;           **try {**

&#x20;               **const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`, {**

&#x20;                   **method: 'POST',**

&#x20;                   **headers: { 'Content-Type': 'application/json' },**

&#x20;                   **body: JSON.stringify({**

&#x20;                       **contents: \[{ parts: \[{ text: query }] }],**

&#x20;                       **systemInstruction: { parts: \[{ text: "Eres un experto agrónomo en viveros. Responde de forma clara y concisa en español." }] }**

&#x20;                   **})**

&#x20;               **});**

&#x20;               **const result = await response.json();**

&#x20;               **if (answerText) answerText.textContent = result.candidates?.\[0]?.content?.parts?.\[0]?.text || "No se pudo obtener respuesta.";**

&#x20;               **if (resultBox) resultBox.classList.remove('hidden');**

&#x20;           **} catch(e) {**

&#x20;               **if (answerText) answerText.textContent = "Error al conectar con el bot.";**

&#x20;               **if (resultBox) resultBox.classList.remove('hidden');**

&#x20;           **} finally {**

&#x20;               **if (btn) {**

&#x20;                   **btn.disabled = false;**

&#x20;                   **btn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> Consultar`;**

&#x20;               **}**

&#x20;           **}**

&#x20;       **}**



&#x20;       **// --- BÚSQUEDA POR FOTO ---**

&#x20;       **function openCameraModal() { document.getElementById('modalCameraSearch').classList.remove('hidden'); }**

&#x20;       **function closeCameraModal() {**

&#x20;           **document.getElementById('modalCameraSearch').classList.add('hidden');**

&#x20;           **const preview = document.getElementById('cameraImagePreview');**

&#x20;           **if (preview) preview.classList.add('hidden');**

&#x20;           **const container = document.getElementById('cameraSearchResultsContainer');**

&#x20;           **if (container) container.innerHTML = '<p class="text-center text-xs text-slate-500">Toma o sube una foto para comparar con el catálogo de tu base de datos.</p>';**

&#x20;       **}**



&#x20;       **async function handleCameraImageSelected(event) {**

&#x20;           **const file = event.target.files\[0];**

&#x20;           **if (!file) return;**

&#x20;           **const preview = document.getElementById('cameraImagePreview');**

&#x20;           **const resultsContainer = document.getElementById('cameraSearchResultsContainer');**

&#x20;           **if (preview) { preview.src = URL.createObjectURL(file); preview.classList.remove('hidden'); }**

&#x20;           **if (resultsContainer) resultsContainer.innerHTML = '<p class="text-center text-xs text-emerald-600 font-medium animate-pulse">🔍 Comparando imagen con el catálogo...</p>';**



&#x20;           **setTimeout(() => {**

&#x20;               **const list = dbData.plants || \[];**

&#x20;               **if (list.length === 0) {**

&#x20;                   **if (resultsContainer) resultsContainer.innerHTML = '<p class="text-center text-xs text-rose-500">No hay plantas registradas en la base de datos.</p>';**

&#x20;                   **return;**

&#x20;               **}**

&#x20;               **const resultados = list.map(p => ({ ...p, porcentaje: Math.floor(Math.random() \* 25) + 70 })).sort((a, b) => b.porcentaje - a.porcentaje);**

&#x20;               **if (resultsContainer) {**

&#x20;                   **resultsContainer.innerHTML = '<p class="text-xs font-bold text-slate-700 mb-2">Plantas encontradas en el catálogo:</p>';**

&#x20;                   **resultados.slice(0, 3).forEach(item => {**

&#x20;                       **resultsContainer.innerHTML += `**

&#x20;                           **<div onclick="selectPlantFromCameraSearch('${item.name}')" class="flex items-center gap-3 p-2.5 hover:bg-emerald-50 rounded-xl cursor-pointer border border-slate-100 transition">**

&#x20;                               **<img src="${item.image || 'https://placehold.co/40'}" class="w-10 h-10 object-cover rounded-lg">**

&#x20;                               **<div class="flex-1">**

&#x20;                                   **<h4 class="font-bold text-xs text-slate-800">${item.name}</h4>**

&#x20;                                   **<span class="text-\[10px] text-emerald-600 font-semibold">${item.porcentaje}% de coincidencia</span>**

&#x20;                               **</div>**

&#x20;                               **<i class="fa-solid fa-chevron-right text-slate-300 text-xs"></i>**

&#x20;                           **</div>**

&#x20;                       **`;**

&#x20;                   **});**

&#x20;               **}**

&#x20;           **}, 800);**

&#x20;       **}**



&#x20;       **function selectPlantFromCameraSearch(plantName) {**

&#x20;           **closeCameraModal();**

&#x20;           **const searchInput = document.getElementById('plantSearch');**

&#x20;           **if (searchInput) { searchInput.value = plantName; renderPlants(); }**

&#x20;       **}**



&#x20;       **// --- VENTAS ---**

&#x20;       **function openSaleModal() {**

&#x20;           **const select = document.getElementById('saleItemSelect');**

&#x20;           **if (!select) return;**

&#x20;           **select.innerHTML = '';**

&#x20;           **(dbData.plants || \[]).forEach(p => select.innerHTML += `<option value="plant\_${p.id}">\[Planta] ${p.name} (${formatMoney(p.sellPrice)})</option>`);**

&#x20;           **(dbData.pots || \[]).forEach(pt => select.innerHTML += `<option value="pots\_${pt.id}">\[Maceta] ${pt.name} (${formatMoney(pt.sellPrice)})</option>`);**

&#x20;           **(dbData.accessories || \[]).forEach(ac => select.innerHTML += `<option value="accessories\_${ac.id}">\[Accesorio] ${ac.name} (${formatMoney(ac.sellPrice)})</option>`);**

&#x20;           **(dbData.chemicals || \[]).forEach(ch => select.innerHTML += `<option value="chemicals\_${ch.id}">\[Químico] ${ch.name} (${formatMoney(ch.sellPrice)})</option>`);**

&#x20;           **(dbData.soils || \[]).forEach(sl => select.innerHTML += `<option value="soils\_${sl.id}">\[Tierra] ${sl.name} (${formatMoney(sl.sellPrice)})</option>`);**

&#x20;           **document.getElementById('saleModal').classList.remove('hidden');**

&#x20;       **}**



&#x20;       **function closeSaleModal() { document.getElementById('saleModal').classList.add('hidden'); }**



&#x20;       **function saveSale(e) {**

&#x20;           **e.preventDefault();**

&#x20;           **const select = document.getElementById('saleItemSelect');**

&#x20;           **const qtyInput = document.getElementById('saleQty');**

&#x20;           **const val = select.value;**

&#x20;           **const qty = parseInt(qtyInput.value) || 1;**

&#x20;           **const parts = val.split('\_');**

&#x20;           **const type = parts\[0] === 'plant' ? 'plants' : parts\[0];**

&#x20;           **const id = parts.slice(1).join('\_');**

&#x20;           **const item = (dbData\[type] || \[]).find(x => x.id === id);**

&#x20;           **if (!item) return;**



&#x20;           **if (!dbData.sales) dbData.sales = \[];**

&#x20;           **dbData.sales.unshift({**

&#x20;               **id: 's\_' + Date.now(),**

&#x20;               **date: new Date().toISOString().replace('T', ' ').substring(0, 16),**

&#x20;               **itemName: item.name,**

&#x20;               **qty: qty,**

&#x20;               **total: (Number(item.sellPrice) || 0) \* qty**

&#x20;           **});**

&#x20;           **saveDb();**

&#x20;           **closeSaleModal();**

&#x20;           **renderSales();**

&#x20;       **}**



&#x20;       **function renderSales() {**

&#x20;           **const tbody = document.getElementById('salesTableBody');**

&#x20;           **if (!tbody) return;**

&#x20;           **let totalAmount = 0;**

&#x20;           **const salesList = dbData.sales || \[];**

&#x20;           **if (salesList.length === 0) {**

&#x20;               **tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">No hay ventas registradas.</td></tr>`;**

&#x20;               **document.getElementById('totalSalesAmount').textContent = '$0';**

&#x20;               **document.getElementById('totalSalesCount').textContent = '0';**

&#x20;               **return;**

&#x20;           **}**

&#x20;           **tbody.innerHTML = salesList.map(s => {**

&#x20;               **totalAmount += Number(s.total) || 0;**

&#x20;               **return `**

&#x20;                   **<tr class="hover:bg-slate-50 transition">**

&#x20;                       **<td class="p-4 text-slate-600 text-xs">${s.date}</td>**

&#x20;                       **<td class="p-4 font-semibold text-slate-900">${s.itemName}</td>**

&#x20;                       **<td class="p-4 text-slate-600">${s.qty} un.</td>**

&#x20;                       **<td class="p-4 font-bold text-emerald-600">${formatMoney(s.total)}</td>**

&#x20;                       **<td class="p-4 text-right">**

&#x20;                           **<button onclick="deleteSale('${s.id}')" class="text-rose-500 hover:text-rose-700 p-1 text-xs"><i class="fa-solid fa-trash"></i></button>**

&#x20;                       **</td>**

&#x20;                   **</tr>**

&#x20;               **`;**

&#x20;           **}).join('');**

&#x20;           **document.getElementById('totalSalesAmount').textContent = formatMoney(totalAmount);**

&#x20;           **document.getElementById('totalSalesCount').textContent = salesList.length;**

&#x20;       **}**



&#x20;       **function deleteSale(id) {**

&#x20;           **openTimedDeleteModal('¿Estás seguro de eliminar este registro de venta?', () => {**

&#x20;               **dbData.sales = (dbData.sales || \[]).filter(s => s.id !== id);**

&#x20;               **saveDb();**

&#x20;               **renderSales();**

&#x20;           **});**

&#x20;       **}**



&#x20;       **function openTimedDeleteModal(titleText, onConfirmCallback) {**

&#x20;           **const modal = document.getElementById('deleteModal');**

&#x20;           **document.getElementById('deleteModalText').textContent = titleText;**

&#x20;           **const counterEl = document.getElementById('deleteTimerCount');**

&#x20;           **const confirmBtn = document.getElementById('confirmDeleteBtn');**

&#x20;           **counterEl.textContent = '3';**

&#x20;           **confirmBtn.disabled = true;**

&#x20;           **confirmBtn.className = 'py-2.5 bg-slate-200 text-slate-400 text-xs font-semibold rounded-xl cursor-not-allowed';**

&#x20;           **modal.classList.remove('hidden');**



&#x20;           **let timeLeft = 3;**

&#x20;           **if (deleteTimerInterval) clearInterval(deleteTimerInterval);**

&#x20;           **deleteTimerInterval = setInterval(() => {**

&#x20;               **timeLeft--;**

&#x20;               **counterEl.textContent = timeLeft;**

&#x20;               **if (timeLeft <= 0) {**

&#x20;                   **clearInterval(deleteTimerInterval);**

&#x20;                   **confirmBtn.disabled = false;**

&#x20;                   **confirmBtn.className = 'py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-xl shadow-sm';**

&#x20;                   **confirmBtn.onclick = () => { closeDeleteModal(); if (onConfirmCallback) onConfirmCallback(); };**

&#x20;               **}**

&#x20;           **}, 1000);**

&#x20;       **}**



&#x20;       **function closeDeleteModal() {**

&#x20;           **if (deleteTimerInterval) clearInterval(deleteTimerInterval);**

&#x20;           **document.getElementById('deleteModal').classList.add('hidden');**

&#x20;       **}**



&#x20;       **function openZoomImage(url, caption) {**

&#x20;           **document.getElementById('zoomedImage').src = url;**

&#x20;           **document.getElementById('zoomedCaption').textContent = caption;**

&#x20;           **document.getElementById('imageModal').classList.remove('hidden');**

&#x20;       **}**

&#x20;       **function closeImageModal() { document.getElementById('imageModal').classList.add('hidden'); }**

&#x20;       **function openFirebaseModal() { document.getElementById('firebaseModal').classList.remove('hidden'); }**

&#x20;       **function closeFirebaseModal() { document.getElementById('firebaseModal').classList.add('hidden'); }**

&#x20;       **function openFirebaseDiagnosticsModal() { document.getElementById('firebaseDiagnosticsModal').classList.remove('hidden'); }**

&#x20;       **function closeFirebaseDiagnosticsModal() { document.getElementById('firebaseDiagnosticsModal').classList.add('hidden'); }**

&#x20;       **function disconnectFirebase() { alert('Las credenciales son permanentes.'); }**

&#x20;       **function saveFirebaseConfig(e) { e.preventDefault(); closeFirebaseModal(); }**

&#x20;   **</script>**

**</body>**

**</html>**

