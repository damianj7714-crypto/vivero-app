&#x20;                                   **<span class="text-emerald-600 block text-\[10px] uppercase font-semibold">Venta</span>**

&#x20;                                   **<span class="font-bold text-emerald-700 text-sm">${formatMoney(sellP)}</span>**

&#x20;                               **</div>**

&#x20;                           **</div>**

&#x20;                           **<div class="flex gap-2 pt-1">**

&#x20;                               **<button onclick="editChemical('${item.id}')" class="flex-1 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">Editar</button>**

&#x20;                               **<button onclick="deleteChemical('${item.id}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold rounded-xl"><i class="fa-solid fa-trash"></i></button>**

&#x20;                           **</div>**

&#x20;                       **</div>**

&#x20;                   **</div>**

&#x20;               **`;**

&#x20;           **}).join('');**

&#x20;       **}**



&#x20;       **// --- RENDER TIERRAS ---**

&#x20;       **function renderSoils() {**

&#x20;           **const grid = document.getElementById('soilsGrid');**

&#x20;           **if (!grid) return;**

&#x20;           **const list = dbData.soils || \[];**



&#x20;           **if (list.length === 0) {**

&#x20;               **grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">No hay tierras o sustratos registrados.</div>`;**

&#x20;               **return;**

&#x20;           **}**



&#x20;           **grid.innerHTML = list.map(item => {**

&#x20;               **const safeName = (item.name || '').replace(/'/g, "\\'").replace(/"/g, '\&quot;');**

&#x20;               **const safeImg = item.image || 'https://placehold.co/400x300/e2e8f0/64748b?text=Tierra';**

&#x20;               **const buyP = Number(item.buyPrice) || 0;**

&#x20;               **const sellP = Number(item.sellPrice) || (buyP \* 2);**



&#x20;               **const buyPriceHTML = hideBuyPrice ? '' : `**

&#x20;                   **<div>**

&#x20;                       **<span class="text-slate-400 block text-\[10px] uppercase font-semibold">Compra</span>**

