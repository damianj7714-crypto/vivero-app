&#x20;                                   **<span class="text-emerald-600 block text-\[10px] uppercase font-semibold">Venta</span>**

&#x20;                                   **<span class="font-bold text-emerald-700 text-sm">${formatMoney(sellP)}</span>**

&#x20;                               **</div>**

&#x20;                           **</div>**

&#x20;                           **<div class="flex gap-2 pt-1">**

&#x20;                               **<button onclick="editSoil('${item.id}')" class="flex-1 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">Editar</button>**

&#x20;                               **<button onclick="deleteSoil('${item.id}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold rounded-xl"><i class="fa-solid fa-trash"></i></button>**

&#x20;                           **</div>**

&#x20;                       **</div>**

&#x20;                   **</div>**

&#x20;               **`;**

&#x20;           **}).join('');**

&#x20;       **}**



&#x20;       **// --- MANEJO DE TIERRAS ---**

&#x20;       **function autoUpdateSoilSell() {**

&#x20;           **const buyInput = document.getElementById('soilBuyPrice');**

&#x20;           **const sellInput = document.getElementById('soilSellPrice');**

&#x20;           **if (buyInput \&\& sellInput) sellInput.value = (parseFloat(buyInput.value) || 0) \* 2;**

&#x20;       **}**



&#x20;       **function openSoilModal(id = null) {**

&#x20;           **const form = document.getElementById('soilForm');**

&#x20;           **if (form) form.reset();**

&#x20;           **document.getElementById('soilEditId').value = '';**

&#x20;           **document.getElementById('soilModalTitle').textContent = id ? 'Editar Tierra / Sustrato' : 'Nueva Tierra / Sustrato';**



&#x20;           **if (id) {**

&#x20;               **const item = (dbData.soils || \[]).find(x => x.id === id);**

&#x20;               **if (item) {**

&#x20;                   **document.getElementById('soilEditId').value = item.id;**

&#x20;                   **document.getElementById('soilName').value = item.name || '';**

&#x20;                   **document.getElementById('soilBrand').value = item.brand || '';**

&#x20;                   **document.getElementById('soilType').value = item.type || 'Tierra Preparada';**

&#x20;                   **document.getElementById('soilMeasure').value = item.measure || '';**

&#x20;                   **document.getElementById('soilBuyPrice').value = item.buyPrice || 3000;**

&#x20;                   **document.getElementById('soilSellPrice').value = item.sellPrice || 6000;**

&#x20;               **}**

&#x20;           **}**

&#x20;           **document.getElementById('soilModal').classList.remove('hidden');**

&#x20;       **}**



&#x20;       **function closeSoilModal() { document.getElementById('soilModal').classList.add('hidden'); }**



&#x20;       **function saveSoil(e) {**

&#x20;           **e.preventDefault();**

&#x20;           **const id = document.getElementById('soilEditId').value;**

&#x20;           **const name = document.getElementById('soilName').value.trim();**

&#x20;           **const brand = document.getElementById('soilBrand').value.trim();**

&#x20;           **const type = document.getElementById('soilType').value;**

&#x20;           **const measure = document.getElementById('soilMeasure').value.trim();**

&#x20;           **const buyPrice = parseFloat(document.getElementById('soilBuyPrice').value) || 0;**

&#x20;           **const sellPrice = parseFloat(document.getElementById('soilSellPrice').value) || (buyPrice \* 2);**

&#x20;           **const fileInput = document.getElementById('soilImageFile');**



&#x20;           **const processSave = (imgUrl) => {**

&#x20;               **if (!dbData.soils) dbData.soils = \[];**

&#x20;               **if (id) {**

&#x20;                   **const idx = dbData.soils.findIndex(x => x.id === id);**

&#x20;                   **if (idx !== -1) {**

&#x20;                       **dbData.soils\[idx] = { ...dbData.soils\[idx], name, brand, type, measure, buyPrice, sellPrice };**

&#x20;                       **if (imgUrl) dbData.soils\[idx].image = imgUrl;**

&#x20;                   **}**

&#x20;               **} else {**

&#x20;                   **dbData.soils.push({**

&#x20;                       **id: 'sl\_' + Date.now(), name, brand, type, measure, buyPrice, sellPrice,**

&#x20;                       **image: imgUrl || 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400'**

&#x20;                   **});**

&#x20;               **}**

&#x20;               **saveDb();**

&#x20;               **closeSoilModal();**

&#x20;               **renderSoils();**

&#x20;           **};**



&#x20;           **if (fileInput \&\& fileInput.files \&\& fileInput.files\[0]) {**

&#x20;               **const reader = new FileReader();**

&#x20;               **reader.onload = function(evt) { processSave(evt.target.result); };**

&#x20;               **reader.readAsDataURL(fileInput.files\[0]);**

&#x20;           **} else {**

&#x20;               **processSave(id ? null : 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400');**

&#x20;           **}**

&#x20;       **}**



&#x20;       **function editSoil(id) { openSoilModal(id); }**



&#x20;       **function deleteSoil(id) {**

&#x20;           **openTimedDeleteModal('¿Estás seguro de eliminar esta tierra o sustrato?', () => {**

&#x20;               **dbData.soils = (dbData.soils || \[]).filter(x => x.id !== id);**

&#x20;               **saveDb();**

&#x20;               **renderSoils();**

&#x20;           **});**

&#x20;       **}**



&#x20;       **// --- MANEJO DE QUÍMICOS ---**

&#x20;       **function autoUpdateChemicalSell() {**

&#x20;           **const buyInput = document.getElementById('chemicalBuyPrice');**

&#x20;           **const sellInput = document.getElementById('chemicalSellPrice');**

&#x20;           **if (buyInput \&\& sellInput) sellInput.value = (parseFloat(buyInput.value) || 0) \* 2;**

&#x20;       **}**



&#x20;       **function openChemicalModal(id = null) {**

&#x20;           **const form = document.getElementById('chemicalForm');**

&#x20;           **if (form) form.reset();**

&#x20;           **document.getElementById('chemicalEditId').value = '';**

&#x20;           **document.getElementById('chemicalModalTitle').textContent = id ? 'Editar Químico' : 'Nuevo Químico';**



&#x20;           **if (id) {**

&#x20;               **const item = (dbData.chemicals || \[]).find(x => x.id === id);**

&#x20;               **if (item) {**

&#x20;                   **document.getElementById('chemicalEditId').value = item.id;**

&#x20;                   **document.getElementById('chemicalName').value = item.name || '';**

&#x20;                   **document.getElementById('chemicalType').value = item.type || '';**

&#x20;                   **document.getElementById('chemicalApplication').value = item.application || '';**

&#x20;                   **document.getElementById('chemicalDilution').value = item.dilution || '';**

&#x20;                   **document.getElementById('chemicalMeasure').value = item.measure || '';**

&#x20;                   **document.getElementById('chemicalBuyPrice').value = item.buyPrice || 4000;**

&#x20;                   **document.getElementById('chemicalSellPrice').value = item.sellPrice || 8000;**

&#x20;               **}**

