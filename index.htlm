&#x20;                       **<div class="p-4 flex-1 flex flex-col justify-between space-y-3">**

&#x20;                           **<div>**

&#x20;                               **<h3 class="font-bold text-slate-900 text-base leading-snug">${item.name}</h3>**

&#x20;                               **<p class="text-xs text-slate-500 mt-1">💦 Aplicación: ${item.application || 'N/A'}</p>**

&#x20;                               **<p class="text-xs text-slate-500">🧪 Disolución: ${item.dilution || 'N/A'} | 📏 Medida: ${item.measure || 'N/A'}</p>**

&#x20;                           **</div>**

&#x20;                           **<div class="bg-slate-50 p-3 rounded-xl border border-slate-100 flex items-center justify-between">**

